{
  "name": "multi-master-video-blog",
  "private": true,
  "version": "0.1.0",
  "description": "Self-hosted media blog with HLS playback and multi-master video switching.",
  "workspaces": [
    "apps/api",
    "apps/web",
    "apps/cms/directus"
  ],
  "scripts": {
    "dev": "npm run dev:web",
    "dev:api": "npm --workspace @multi-master-video-blog/api run dev",
    "start:api": "npm --workspace @multi-master-video-blog/api run start",
    "api:start": "node scripts/service-control.cjs api start",
    "api:stop": "node scripts/service-control.cjs api stop",
    "api:restart": "node scripts/service-control.cjs api restart",
    "api:status": "node scripts/service-control.cjs api status",
    "api:health": "node scripts/service-control.cjs api health",
    "test:api": "npm --workspace @multi-master-video-blog/api run test",
    "test:security": "node --test tests/security.test.cjs",
    "test:album-api": "node scripts/test-album-api.cjs",
    "test:film-scan-cleanup": "node scripts/test-film-scan-cleanup.cjs",
    "dev:web": "npm --workspace @multi-master-video-blog/web run dev",
    "build:web": "npm --workspace @multi-master-video-blog/web run build",
    "test:web": "npm --workspace @multi-master-video-blog/web run test",
    "start:web": "npm --workspace @multi-master-video-blog/web run start",
    "web:start": "node scripts/service-control.cjs web start",
    "web:stop": "node scripts/service-control.cjs web stop",
    "web:restart": "node scripts/service-control.cjs web restart",
    "web:rebuild-restart": "node scripts/service-control.cjs web rebuild-restart",
    "web:status": "node scripts/service-control.cjs web status",
    "web:health": "node scripts/service-control.cjs web health",
    "bootstrap:cms": "npm --workspace @multi-master-video-blog/cms run bootstrap",
    "setup:cms-schema": "node scripts/setup-directus-schema.cjs",
    "backfill:video-source-formats": "node scripts/backfill-video-source-formats.cjs",
    "migrate:cms:postgres": "node scripts/migrate-directus-sqlite-to-postgres.cjs",
    "dev:cms": "npm --workspace @multi-master-video-blog/cms run dev",
    "start:cms": "npm --workspace @multi-master-video-blog/cms run start",
    "manager": "node scripts/manager-dashboard.cjs",
    "manager:start": "powershell -ExecutionPolicy Bypass -File deployment/windows/manager-service.ps1 start",
    "manager:stop": "powershell -ExecutionPolicy Bypass -File deployment/windows/manager-service.ps1 stop",
    "manager:restart": "powershell -ExecutionPolicy Bypass -File deployment/windows/manager-service.ps1 restart",
    "manager:status": "powershell -ExecutionPolicy Bypass -File deployment/windows/manager-service.ps1 status",
    "health": "node scripts/health-check.cjs",
    "test:db": "node scripts/test-directus-db.cjs",
    "test:cms-schema": "node scripts/test-directus-schema.cjs",
    "test:cms-crud": "node scripts/test-directus-crud.cjs",
    "test:manager": "node --test scripts/test-manager-powershell.cjs scripts/test-manager-lifecycle.cjs scripts/test-manager-launcher.cjs",
    "postgres:start": "node scripts/service-control.cjs postgres start",
    "postgres:stop": "node scripts/service-control.cjs postgres stop",
    "postgres:restart": "node scripts/service-control.cjs postgres restart",
    "postgres:status": "node scripts/service-control.cjs postgres status",
    "postgres:health": "node scripts/service-control.cjs postgres health",
    "cms:start": "node scripts/service-control.cjs cms start",
    "cms:stop": "node scripts/service-control.cjs cms stop",
    "cms:restart": "node scripts/service-control.cjs cms restart",
    "cms:status": "node scripts/service-control.cjs cms status",
    "cms:health": "node scripts/service-control.cjs cms health",
    "services:start": "node scripts/service-control.cjs stack start-all",
    "services:stop": "node scripts/service-control.cjs stack stop-all",
    "services:restart": "node scripts/service-control.cjs stack restart-all",
    "services:update": "node scripts/service-control.cjs stack refresh-app",
    "services:status": "node scripts/service-control.cjs stack status",
    "services:health": "node scripts/service-control.cjs stack health"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "proper-lockfile": "4.1.2"
  }
}
