{
  "name": "multi-master-video-blog",
  "private": true,
  "version": "0.1.0",
  "description": "Self-hosted media blog with HLS playback and multi-master video switching.",
  "workspaces": [
    "apps/api",
    "apps/web",
    "apps/cms/directus"
  ],
  "scripts": {
    "dev": "npm run dev:web",
    "dev:api": "npm --workspace @multi-master-video-blog/api run dev",
    "start:api": "npm --workspace @multi-master-video-blog/api run start",
    "api:start": "powershell -ExecutionPolicy Bypass -File deployment/windows/api-service.ps1 start",
    "api:stop": "powershell -ExecutionPolicy Bypass -File deployment/windows/api-service.ps1 stop",
    "api:restart": "powershell -ExecutionPolicy Bypass -File deployment/windows/api-service.ps1 restart",
    "api:status": "powershell -ExecutionPolicy Bypass -File deployment/windows/api-service.ps1 status",
    "api:health": "powershell -ExecutionPolicy Bypass -File deployment/windows/api-service.ps1 health",
    "test:api": "npm --workspace @multi-master-video-blog/api run test",
    "dev:web": "npm --workspace @multi-master-video-blog/web run dev",
    "build:web": "npm --workspace @multi-master-video-blog/web run build",
    "test:web": "npm --workspace @multi-master-video-blog/web run test",
    "start:web": "npm --workspace @multi-master-video-blog/web run start",
    "web:start": "powershell -ExecutionPolicy Bypass -File deployment/windows/web-service.ps1 start",
    "web:stop": "powershell -ExecutionPolicy Bypass -File deployment/windows/web-service.ps1 stop",
    "web:restart": "powershell -ExecutionPolicy Bypass -File deployment/windows/web-service.ps1 restart",
    "web:rebuild-restart": "powershell -ExecutionPolicy Bypass -File deployment/windows/web-service.ps1 rebuild-restart",
    "web:status": "powershell -ExecutionPolicy Bypass -File deployment/windows/web-service.ps1 status",
    "web:health": "powershell -ExecutionPolicy Bypass -File deployment/windows/web-service.ps1 health",
    "bootstrap:cms": "npm --workspace @multi-master-video-blog/cms run bootstrap",
    "setup:cms-schema": "node scripts/setup-directus-schema.cjs",
    "migrate:cms:postgres": "node scripts/migrate-directus-sqlite-to-postgres.cjs",
    "dev:cms": "npm --workspace @multi-master-video-blog/cms run dev",
    "start:cms": "npm --workspace @multi-master-video-blog/cms run start",
    "manager": "node scripts/manager-dashboard.cjs",
    "manager:start": "powershell -ExecutionPolicy Bypass -File deployment/windows/manager-service.ps1 start",
    "manager:stop": "powershell -ExecutionPolicy Bypass -File deployment/windows/manager-service.ps1 stop",
    "manager:restart": "powershell -ExecutionPolicy Bypass -File deployment/windows/manager-service.ps1 restart",
    "manager:status": "powershell -ExecutionPolicy Bypass -File deployment/windows/manager-service.ps1 status",
    "health": "node scripts/health-check.cjs",
    "test:db": "node scripts/test-directus-db.cjs",
    "test:cms-schema": "node scripts/test-directus-schema.cjs",
    "test:cms-crud": "node scripts/test-directus-crud.cjs"
  },
  "engines": {
    "node": ">=22"
  }
}
