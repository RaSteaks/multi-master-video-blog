RESOURCE_PROFILE=low-2gb
PUBLIC_URL=http://localhost:8080
HTTP_BIND=0.0.0.0
HTTP_PORT=8080
DB_DATABASE=video_blog
DB_USER=directus
DB_PASSWORD=
DIRECTUS_KEY=
DIRECTUS_SECRET=
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
# Create a limited Directus service account after bootstrap/schema initialization.
SERVICE_EMAIL=service@example.com
SERVICE_PASSWORD=
UPLOAD_API_TOKEN=
ARTICLE_API_TOKEN=
REVALIDATE_SECRET=
# Optional HTTPS override; directory must contain fullchain.pem and privkey.pem.
TLS_CERT_DIR=/etc/video-blog/certs
HTTPS_PORT=8443
# Optional Vulkan override: host render node and its numeric group ID.
VULKAN_DEVICE=/dev/dri/renderD128
RENDER_GID=109

# Optional least-privilege health account; otherwise bootstrap admin credentials apply.
CMS_HEALTH_EMAIL=
CMS_HEALTH_PASSWORD=

# Optional Directus OSS storage. Replace the region and endpoint for your bucket.
# Set STORAGE_LOCATIONS once; keep local second for existing files.
# STORAGE_LOCATIONS=oss,local
# STORAGE_OSS_DRIVER=s3
# STORAGE_OSS_BUCKET=rasteaks-blog
# STORAGE_OSS_REGION=cn-hangzhou
# STORAGE_OSS_ENDPOINT=https://s3.oss-cn-hangzhou-internal.aliyuncs.com
# STORAGE_OSS_ROOT=blog_all
# STORAGE_OSS_KEY=
# STORAGE_OSS_SECRET=
