PUBLIC_URL=https://example.com
DIRECTUS_URL=http://127.0.0.1:8055
KEY=
SECRET=
DB_CLIENT=pg
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=video_blog
DB_USER=directus
DB_PASSWORD=
DB_SSL=false
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
STORAGE_LOCATIONS=local
STORAGE_LOCAL_DRIVER=local
STORAGE_LOCAL_ROOT=/var/lib/video-blog/uploads
EXTENSIONS_PATH=/var/lib/video-blog/extensions

# Optional dedicated account for authenticated Directus 12 health checks.
# Otherwise the existing service/admin bootstrap account is used; keep credentials current.
DIRECTUS_HEALTH_EMAIL=
DIRECTUS_HEALTH_PASSWORD=

# Optional Directus OSS storage. Replace the region and endpoint for your bucket.
# Set STORAGE_LOCATIONS once; keep local second for existing files.
# STORAGE_LOCATIONS=oss,local
# STORAGE_OSS_DRIVER=s3
# STORAGE_OSS_BUCKET=rasteaks-blog
# STORAGE_OSS_REGION=cn-hangzhou
# STORAGE_OSS_ENDPOINT=https://s3.oss-cn-hangzhou-internal.aliyuncs.com
# STORAGE_OSS_ROOT=blog_all
# STORAGE_OSS_KEY=
# STORAGE_OSS_SECRET=
