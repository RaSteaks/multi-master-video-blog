# Install with visudo validation; grant only the exact unit/action pairs.
admin ALL=(root) NOPASSWD: /usr/bin/systemctl start postgresql@17-main.service, /usr/bin/systemctl stop postgresql@17-main.service, /usr/bin/systemctl restart postgresql@17-main.service
admin ALL=(root) NOPASSWD: /usr/bin/systemctl start video-blog-cms.service, /usr/bin/systemctl stop video-blog-cms.service, /usr/bin/systemctl restart video-blog-cms.service
admin ALL=(root) NOPASSWD: /usr/bin/systemctl start video-blog-api.service, /usr/bin/systemctl stop video-blog-api.service, /usr/bin/systemctl restart video-blog-api.service
admin ALL=(root) NOPASSWD: /usr/bin/systemctl start video-blog-web.service, /usr/bin/systemctl stop video-blog-web.service, /usr/bin/systemctl restart video-blog-web.service
# Manager restarts itself; --no-block lets systemd stop the requesting process safely.
admin ALL=(root) NOPASSWD: /usr/bin/systemctl --no-block restart video-blog-manager.service
