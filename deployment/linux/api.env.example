DIRECTUS_URL=http://127.0.0.1:8055
DIRECTUS_EMAIL=service@example.com
DIRECTUS_PASSWORD=
UPLOAD_API_TOKEN=
ARTICLE_API_TOKEN=
MEDIA_ROOT=/var/lib/video-blog/media
# Keep scan originals outside the public media tree.
FILM_SCAN_ROOT=/var/lib/video-blog/.private-media/film-scans
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe

# Durable resumable uploads; keep this private directory on the media volume.
# Empty uses the sibling .private-media/video-uploads directory.
VIDEO_UPLOAD_ROOT=
VIDEO_UPLOAD_MAX_BYTES=8589934592
VIDEO_UPLOAD_QUOTA_BYTES=21474836480
VIDEO_UPLOAD_MAX_SESSIONS=32
VIDEO_UPLOAD_TTL_HOURS=168
# Total receive deadline for legacy whole-file clients; idle reads still expire after 120s.
UPLOAD_REQUEST_TIMEOUT_MS=86400000
