[Unit]
Description=Build the Video Blog production frontend

[Service]
Type=oneshot
User=video-blog
Group=video-blog
WorkingDirectory=/opt/video-blog/current
Environment=NODE_ENV=production
Environment=CMS_RUNTIME_ONLY=true
# A custom checkout may not have resources.env yet. Its explicit profile wins below.
Environment=RESOURCE_PROFILE=low-2gb
EnvironmentFile=-/etc/video-blog/resources.env
EnvironmentFile=-/etc/video-blog/web.env
ExecStart=/usr/bin/node scripts/run-service.cjs build
TimeoutStartSec=30min
UMask=0022
NoNewPrivileges=true
PrivateTmp=true
