HOST=127.0.0.1
PORT=8055
PUBLIC_URL=http://127.0.0.1:8055

# Generate distinct random keys before bootstrap; never deploy reusable example secrets.
KEY=
SECRET=

DB_CLIENT=pg
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=multi_master_video_blog
DB_USER=directus
DB_PASSWORD=replace-with-postgres-password
DB_SSL=false

# SQLite legacy/local fallback:
# DB_CLIENT=sqlite3
# DB_FILENAME=./database/data.db

ADMIN_EMAIL=admin@example.com
# Set a strong administrator password before bootstrap.
ADMIN_PASSWORD=

STORAGE_LOCATIONS=local
STORAGE_LOCAL_DRIVER=local
STORAGE_LOCAL_ROOT=./uploads

# Use scripts/run-service.cjs cms to apply the selected profile's heap/pool defaults.
# RESOURCE_PROFILE=low-2gb
# DB_POOL__MIN=0
# DB_POOL__MAX=3
# ASSETS_TRANSFORM_MAX_CONCURRENT=1

# Optional dedicated account for authenticated Directus 12 health checks.
# Otherwise the existing service/admin bootstrap account is used; keep credentials current.
DIRECTUS_HEALTH_EMAIL=
DIRECTUS_HEALTH_PASSWORD=
