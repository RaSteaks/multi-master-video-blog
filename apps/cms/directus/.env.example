HOST=127.0.0.1
PORT=8055
PUBLIC_URL=http://127.0.0.1:8055

KEY=replace-with-local-development-key
SECRET=replace-with-local-development-secret

DB_CLIENT=pg
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=multi_master_video_blog
DB_USER=directus
DB_PASSWORD=replace-with-postgres-password
DB_SSL=false

# SQLite legacy/local fallback:
# DB_CLIENT=sqlite3
# DB_FILENAME=./database/data.db

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=password

STORAGE_LOCATIONS=local
STORAGE_LOCAL_DRIVER=local
STORAGE_LOCAL_ROOT=./uploads
