HOST=127.0.0.1
PORT=8060

DIRECTUS_URL=http://127.0.0.1:8055
DIRECTUS_EMAIL=admin@example.com
DIRECTUS_PASSWORD=change-this-local-password

UPLOAD_API_TOKEN=__REPLACE_WITH_RANDOM_UPLOAD_TOKEN__
ARTICLE_API_TOKEN=__REPLACE_WITH_RANDOM_ARTICLE_TOKEN__

MEDIA_ROOT=../../media
MAX_UPLOAD_BYTES=2147483648
# Limit concurrent video pipelines and bound queued requests (milliseconds for timeouts).
VIDEO_PROCESS_CONCURRENCY=1
VIDEO_PROCESS_MAX_PENDING=4
VIDEO_PROCESS_QUEUE_TIMEOUT_MS=60000
VIDEO_PROCESS_TIMEOUT_MS=3600000
# Maximum time for automatic HDR -> SDR encoding (milliseconds).
VIDEO_SDR_PROCESS_TIMEOUT_MS=3600000

# Article editor upload limits.
MAX_ARTICLE_UPLOAD_BYTES=67108864
MAX_ARTICLE_IMAGE_BYTES=12582912
MAX_ARTICLE_MARKDOWN_BYTES=2097152
MAX_ARTICLE_IMAGES=24

# Album SDR/HDR upload limits.
MAX_ALBUM_UPLOAD_BYTES=536870912
MAX_ALBUM_IMAGE_BYTES=67108864
MAX_ALBUM_PHOTOS=24

# Use matched recent FFmpeg/FFprobe builds for adaptive libplacebo/Vulkan and decoded Dolby metadata.
# Empty values fall back to npm binaries, which may not contain these capabilities.
FFMPEG_PATH=
FFPROBE_PATH=
