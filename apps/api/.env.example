HOST=127.0.0.1
PORT=8060

DIRECTUS_URL=http://127.0.0.1:8055
DIRECTUS_EMAIL=admin@example.com
DIRECTUS_PASSWORD=change-this-local-password

UPLOAD_API_TOKEN=__REPLACE_WITH_RANDOM_UPLOAD_TOKEN__
ARTICLE_API_TOKEN=__REPLACE_WITH_RANDOM_ARTICLE_TOKEN__

MEDIA_ROOT=../../media
# Optional private work directory outside MEDIA_ROOT; default is its sibling .private-media/film-scans.
# Keep it on the same volume for automatic, non-overwriting legacy migration.
FILM_SCAN_ROOT=
# Explicit public CMS file IDs for local About Markdown / SITE_HOME_AVATAR_URL, if used.
# Published CMS content and site_settings backgrounds are authorized automatically.
PUBLIC_ASSET_IDS=
MAX_UPLOAD_BYTES=2147483648
# Limit concurrent video pipelines and bound queued requests (milliseconds for timeouts).
VIDEO_PROCESS_CONCURRENCY=1
VIDEO_PROCESS_MAX_PENDING=4
VIDEO_PROCESS_QUEUE_TIMEOUT_MS=60000
VIDEO_PROCESS_TIMEOUT_MS=3600000
# Maximum time for automatic HDR -> SDR encoding (milliseconds).
VIDEO_SDR_PROCESS_TIMEOUT_MS=3600000

# Article editor upload limits.
MAX_ARTICLE_UPLOAD_BYTES=67108864
MAX_ARTICLE_IMAGE_BYTES=12582912
MAX_ARTICLE_MARKDOWN_BYTES=2097152
MAX_ARTICLE_IMAGES=24

# Album SDR/HDR upload limits.
MAX_ALBUM_UPLOAD_BYTES=536870912
MAX_ALBUM_IMAGE_BYTES=67108864
MAX_ALBUM_PHOTOS=24

# Use matched recent FFmpeg/FFprobe builds for adaptive libplacebo/Vulkan and decoded Dolby metadata.
# Empty values fall back to npm binaries, which may not contain these capabilities.
FFMPEG_PATH=
FFPROBE_PATH=

# Optional low-resource profile; unset preserves the ordinary deployment defaults.
# RESOURCE_PROFILE=low-2gb
# MEDIA_PROCESS_CONCURRENCY=1
# MEDIA_PROCESS_MAX_PENDING=4
# MEDIA_PROCESS_QUEUE_TIMEOUT_MS=60000
# FFMPEG_THREADS=1
# SHARP_CONCURRENCY=1
# SHARP_CACHE_MIB=16
# FILM_SCAN_MAX_PIXELS=24000000
# PROCESS_MAX_OUTPUT_BYTES=16777216
# PROCESS_MAX_LOG_BYTES=65536

# Durable resumable uploads; keep this private directory on the media volume.
# Empty uses the sibling .private-media/video-uploads directory.
VIDEO_UPLOAD_ROOT=
VIDEO_UPLOAD_MAX_BYTES=8589934592
VIDEO_UPLOAD_QUOTA_BYTES=21474836480
VIDEO_UPLOAD_MAX_SESSIONS=32
VIDEO_UPLOAD_TTL_HOURS=168
# Total receive deadline for legacy whole-file clients; idle reads still expire after 120s.
UPLOAD_REQUEST_TIMEOUT_MS=86400000
