# Dependencies
node_modules/

# Next.js / frontend build output
.next/
out/
dist/
build/
.turbo/
.vercel/
*.tsbuildinfo

# Astro or other optional frontend caches
.astro/

# Tests, verification scripts, and sample fixtures are local-only deployment exclusions.
/apps/api/test/
/apps/web/**/*.test.*
/apps/web/**/*.spec.*
/scripts/test-*

# Generated test reports and caches.
coverage/
.nyc_output/
.vitest/
playwright-report/
blob-report/
test-results/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment and secrets
.env
.env.*
!.env.example
!*.env.example

# Local editable site content
apps/web/content/about.md
!apps/web/content/about.example.md

# Directus local state
# Keep the standalone SQLite preview CMS, credentials, dependencies, and data local.
/cms/
apps/cms/directus/database/
apps/cms/directus/uploads/
apps/cms/directus/extensions/.cache/

# Upload API local state
apps/api/tmp/

# Local media storage
media/*
!media/.gitkeep

# Local source exports for upload/transcode tests
exports/

# SSL certificates and private keys
*.pem
*.key
*.crt
*.pfx

# OS files
.DS_Store
Thumbs.db
Desktop.ini

# Editor local state
.vscode/*
!.vscode/extensions.json
!.vscode/settings.example.json
.idea/

# Local UI tool metadata; shared workflow specifications are maintained in docs/.
/UX-CONTRACT.md
/premium-ui.json

# Generated UI audit reports are local verification output.
/premium-audit*.json

# Temporary files
tmp/
temp/
*.tmp

.claude
.vscode

backups/
start-all-services.bat
start-api.bat
start-web.bat
start-postgresql.bat
start-manager.bat
start-cms.bat

# Local Kodak reference downloads and generated extracts
output/
/docs/kodak-film-data/source-pages/
/docs/kodak-film-data/text/

# Python bytecode caches
__pycache__/
*.pyc
*.pyo
